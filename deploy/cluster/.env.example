# Shared external MySQL used by every DolphinScheduler service.
DS_IMAGE=registry.example.com/dolphinscheduler-cluster:3.4.2
DS_DB_HOST=10.0.0.10
DS_DB_PORT=3306
DS_DB_NAME=dolphinscheduler
DS_DB_USER=dolphinscheduler
DS_DB_PASSWORD=change-me

# Public Nginx port on the gateway node.
NGINX_PORT=8080
TZ=Asia/Shanghai
